# Workflow: backend extract, pull and compile
# Requires an authenticated Transifex CLI.
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel extract -F pyproject.toml -o flask_security/translations/messages.pot flask_security
# 3) $ tx pull -a
# 4) $ pybabel compile -d flask_security/translations

# Optional workflow: push extracted sources
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ tx push -s

# Optional workflow: new backend language
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel init -i flask_security/translations/messages.pot -d flask_security/translations -l <lang>
# 3) Translate the PO file, then compile:
#    $ pybabel compile -d flask_security/translations -l <lang>

[main]
host = https://app.transifex.com

[o:inveniosoftware:p:invenio:r:flask-security-messages]
file_filter = flask_security/translations/<lang>/LC_MESSAGES/messages.po
source_file = flask_security/translations/messages.pot
source_lang = en
type = PO
